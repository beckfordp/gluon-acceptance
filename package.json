{
  "name": "gluon-acceptance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bddgen": "bddgen",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:acceptance": "bddgen && playwright test",
    "coverage:matrix": "node --disable-warning=ExperimentalWarning scripts/coverage-matrix.ts",
    "test:acceptance:ui": "bddgen && playwright test --ui",
    "test:acceptance:headed": "bddgen && SLOW_MO=${SLOW_MO:-500} playwright test --headed",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "playwright-bdd": "9.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
